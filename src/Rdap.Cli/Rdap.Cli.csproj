<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>rdap</AssemblyName>
    <RootNamespace>Rdap.Cli</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <PublishAot>true</PublishAot>
    <OptimizationPreference>Size</OptimizationPreference>
    <StackTraceSupport>false</StackTraceSupport>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Rdap.Tests" />
    <InternalsVisibleTo Include="Rdap.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Rdap.Core/Rdap.Core.csproj" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

</Project>
